# ==============================================================================
# ⚖️ Enterprise Legal & Court Session Management SaaS — Environment Template
# Copy this file to `.env` for local development or configure in Vercel / Cloud
# ==============================================================================

# --- 1. Security & Cryptographic Session Signing (Required in Production) ---
# Must be a strong random secret (>= 32 characters). Generate via:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_strong_64_char_random_hex_secret_for_hmac_sessions

# --- 2. Primary Account & Multi-Tenant Metadata Store (Supabase) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_TABLE_NAME=app_users

# --- 3. Local Development Bootstrap Admin (Development Only — Ignored in Prod) ---
# Used ONLY when Supabase is not configured locally to seed a local admin account
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- 4. AI Legal Extraction Engine (OpenRouter / OpenAI Compatible) ---
AI_API_KEY=your_openrouter_or_openai_api_key
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=qwen/qwen-2.5-7b-instruct

# --- 5. Automated Court Session Reminders & Timezone ---
CRON_SECRET=replace_with_strong_random_cron_bearer_secret
REMINDER_CRON_EXPRESSION=*/15 * * * *
COURT_TIMEZONE_OFFSET_HOURS=3

# --- 6. Optional Platform-Level Google Sheets Diagnostics (Admin Only) ---
# Note: Law office tenants connect their isolated Google Spreadsheets via Admin/Office Settings.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Sessions
GOOGLE_SERVICE_ACCOUNT_JSON=

